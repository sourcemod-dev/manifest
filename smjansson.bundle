me":"json_is_false","refLine":52,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"value":"( json_typeof(%1) == JSON_FALSE )"},"json_is_boolean":{"name":"json_is_boolean","refLine":55,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"value":"( json_typeof(%1) == JSON_TRUE || json_typeof(%1) == JSON_FALSE )"},"json_is_object":{"name":"json_is_object","refLine":46,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"value":"( json_typeof(%1) == JSON_OBJECT )"},"json_is_number":{"name":"json_is_number","refLine":54,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"value":"( json_typeof(%1) == JSON_INTEGER || json_typeof(%1) == JSON_REAL )"}},"enums":{"json_type":{"name":"json_type","refLine":19,"docStart":78,"docEnd":538,"docs":{"brief":"--- Type\n\nThe JSON specification (RFC 4627) defines the following data types:\nobject, array, string, number, boolean, and null.\nJSON types are used dynamically; arrays and objects can hold any\nother data type, including themselves. For this reason, Jansson's\ntype system is also dynamic in nature. There's one Handle type to\nrepresent all JSON values, and the referenced structure knows the\ntype of the JSON value it holds.","tags":[{"tag":"","text":"--- Type\n\nThe JSON specification (RFC 4627) defines the following data types:\nobject, array, string, number, boolean, and null.\nJSON types are used dynamically; arrays and objects can hold any\nother data type, including themselves. For this reason, Jansson's\ntype system is also dynamic in nature. There's one Handle type to\nrepresent all JSON values, and the referenced structure knows the\ntype of the JSON value it holds."}]},"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"6acf387e4d354ce7bd8205f54e2cb58fc1130b7c","count":55,"time":1646148639}},"entries":{"JSON_FALSE":{"name":"JSON_FALSE","refLine":26,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"value":null},"JSON_OBJECT":{"name":"JSON_OBJECT","refLine":20,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"value":null},"JSON_ARRAY":{"name":"JSON_ARRAY","refLine":21,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"value":null},"JSON_STRING":{"name":"JSON_STRING","refLine":22,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"value":null},"JSON_NULL":{"name":"JSON_NULL","refLine":27,"docStart":0,"docEnd":0,"docs":null,"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22