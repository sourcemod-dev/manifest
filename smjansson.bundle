:"Inserts value to hArray at position iIndex, shifting the elements at\niIndex and after it one position towards the end of the array.\nThis function automatically closes the Handle to the value object.","tags":[{"tag":"","text":"Inserts value to hArray at position iIndex, shifting the elements at\niIndex and after it one position towards the end of the array.\nThis function automatically closes the Handle to the value object."},{"tag":"param:hArray","text":"Handle to JSON array"},{"tag":"param:iIndex","text":"Position to insert at"},{"tag":"param:hValue","text":"Value to store in the array"},{"tag":"return","text":"True on success."}]},"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"kind":"native","returnType":"bool","arguments":[{"type":"Handle","name":"hArray","decl":"Handle hArray","default":null},{"type":"int","name":"iIndex","decl":"int iIndex","default":null},{"type":"Handle","name":"hValue","decl":"Handle hValue","default":null}]},"json_array_remove":{"name":"json_array_remove","refLine":512,"docStart":15788,"docEnd":16068,"docs":{"brief":"Removes the element in hArray at position iIndex, shifting the\nelements after iIndex one position towards the start of the array.","tags":[{"tag":"","text":"Removes the element in hArray at position iIndex, shifting the\nelements after iIndex one position towards the start of the array."},{"tag":"param:hArray","text":"Handle to JSON array"},{"tag":"param:iIndex","text":"Position to insert at"},{"tag":"return","text":"True on success."}]},"metadata":{"created":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289},"last_updated":{"hash":"dc22512299c4e4d826e59b86f42c3980a9d44af6","count":19,"time":1574306289}},"kind":"native","returnType":"bool","arguments":[{"type":"Handle","name":"hArray","decl":"Handle hArray","default":null},{"type":"int","name